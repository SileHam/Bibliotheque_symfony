<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>BIBLIOTHEQUE - {% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="{{ asset('assets/img/bibliotheque.svg') }}">
        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
            <link rel="stylesheet" href="{{ asset('assets/css/style.css') }}">
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
    </head>
    <body class="bg-light">
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center fw-bold" href="{{ path('home') }}">
                    <img src="{{ asset('assets/img/bibliotheque.svg') }}" alt="" width="40" height="40" class="me-2 navbar-brand-icon" aria-hidden="true">
                    <span class="navbar-brand-text">BIBLIOTHEQUE</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('home') }}"><i class="fas fa-home me-1"></i> Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('livre_index') }}"><i class="fas fa-book me-1"></i> Livres</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('auteur_index') }}"><i class="fas fa-feather-alt me-1"></i> Auteurs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('genre_index') }}"><i class="fas fa-tags me-1"></i> Genres</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        {% if not app.user %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_login') }}"><i class="fas fa-sign-in-alt me-1"></i> Connexion</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_register') }}"><i class="fas fa-user-plus me-1"></i> Inscription</a>
                            </li>
                        {% else %}
                            {% set cartCount = cart_item_count() %}
                            <li class="nav-item">
                                <a class="nav-link position-relative" href="{{ path('cart_index') }}">
                                    <i class="fas fa-cart-shopping me-1"></i> Panier
                                    {% if cartCount > 0 %}
                                        <span class="badge rounded-pill bg-light text-primary ms-1">{{ cartCount }}</span>
                                    {% endif %}
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('profile_show') }}"><i class="fas fa-user-circle me-1"></i> Mon profil</a>
                            </li>
                            {% if is_granted('ROLE_ADMIN') %}
                                <li class="nav-item">
                                    <a class="nav-link text-warning" href="{{ path('admin_dashboard') }}"><i class="fas fa-shield-alt me-1"></i> Dashboard Admin</a>
                                </li>
                            {% endif %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_logout') }}"><i class="fas fa-sign-out-alt me-1"></i> Deconnexion</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <main class="py-4">
            {% block body %}{% endblock %}
        </main>

        <footer class="bg-dark text-light py-4 mt-5">
            <div class="container text-center">
                <p class="mb-0">&copy; {{ "now"|date("Y") }} BIBLIOTHEQUE - Votre librairie en ligne</p>
            </div>
        </footer>

        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </body>
</html>
