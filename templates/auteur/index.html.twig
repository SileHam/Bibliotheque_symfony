{% extends 'navbar.html.twig' %}

{% block title %}Liste des Auteurs{% endblock %}

{% block body %}
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold"><i class="fas fa-feather-alt text-primary me-2"></i>Auteurs</h1>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('auteur_new') }}" class="btn btn-success">
                <i class="fas fa-plus-circle me-2"></i>Ajouter un auteur
            </a>
        {% endif %}
    </div>

    <!-- Flash Messages -->
    {% for message in app.flashes('Success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    {% for message in app.flashes('Warning') %}
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <!-- Table -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nom & Prénom</th>
                            <th class="text-center">Sexe</th>
                            <th>Date de naissance</th>
                            <th>Nationalité</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for auteur in auteurs %}
                            <tr>
                                <td>
                                    <strong>{{ auteur.nomPrenom }}</strong>
                                </td>
                                <td class="text-center">
                                    {% if auteur.sexe == 'M' %}
                                        <span class="badge bg-primary"><i class="fas fa-mars"></i> Masculin</span>
                                    {% elseif auteur.sexe == 'F' %}
                                        <span class="badge bg-danger"><i class="fas fa-venus"></i> Féminin</span>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <i class="fas fa-calendar text-muted me-1"></i>
                                    {{ auteur.dateDeNaissance ? auteur.dateDeNaissance|date('d/m/Y') : 'Non spécifiée' }}
                                </td>
                                <td>
                                    <span class="badge bg-info">{{ auteur.nationalite }}</span>
                                </td>
                                <td class="text-center">
                                    <a href="{{ path('auteur_show', {'id': auteur.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a href="{{ path('auteur_edit', {'id': auteur.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="fas fa-feather-alt fa-3x mb-3 d-block"></i>
                                    Aucun auteur trouvé
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
