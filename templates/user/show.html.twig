{% extends 'navbar.html.twig' %}

{% block title %}Utilisateur{% endblock %}

{% block body %}
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6 fw-bold mb-0"><i class="fas fa-user text-primary me-2"></i>Fiche utilisateur</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('user_index') }}">Retour</a>
            <a class="btn btn-primary" href="{{ path('user_edit', {'id': user.id}) }}">Modifier</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light">
                    <h2 class="h5 mb-0">Informations du compte</h2>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Id</dt>
                        <dd class="col-sm-8">{{ user.id }}</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">{{ user.email }}</dd>

                        <dt class="col-sm-4">Roles</dt>
                        <dd class="col-sm-8">
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="badge bg-warning text-dark">Administrateur</span>
                            {% else %}
                                <span class="badge bg-secondary">Utilisateur</span>
                            {% endif %}
                        </dd>

                        <dt class="col-sm-4">Verification</dt>
                        <dd class="col-sm-8">
                            {% if user.isVerified %}
                                <span class="badge bg-success">Verifie</span>
                            {% else %}
                                <span class="badge bg-secondary">Non verifie</span>
                            {% endif %}
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white">
                    <h2 class="h5 mb-0">Historique recent</h2>
                </div>
                <div class="card-body">
                    {% if recentActivities is not empty %}
                        <div class="list-group list-group-flush">
                            {% for activity in recentActivities %}
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-start gap-3">
                                        <div>
                                            <div class="fw-semibold">{{ activity.description }}</div>
                                            <div class="text-muted small">{{ activity.action }}</div>
                                        </div>
                                        <span class="badge bg-light text-dark">{{ activity.createdAt|date('d/m/Y H:i') }}</span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info mb-0">Aucune activite pour cet utilisateur.</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        {{ include('user/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
