{% extends 'navbar.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="container">
    <section class="hero-section rounded-4 p-4 p-lg-5 mb-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="hero-kicker text-uppercase fw-semibold">Catalogue enrichi</span>
                <h1 class="display-4 fw-bold text-primary mt-3 mb-3">Une vraie librairie en ligne pour découvrir, comparer et acheter vos livres.</h1>
                <p class="lead text-muted mb-4">
                    Parcourez des ouvrages avec couverture, résumé, prix, stock et panier persistant pour chaque utilisateur connecté.
                </p>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    {% for genre in genres|slice(0, 6) %}
                        <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis px-3 py-2">{{ genre.nom }}</span>
                    {% endfor %}
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a href="{{ path('livre_index') }}" class="btn btn-primary btn-lg">
                        <i class="fas fa-book-open me-2"></i>Voir le catalogue
                    </a>
                    {% if app.user %}
                        <a href="{{ path('cart_index') }}" class="btn btn-outline-primary btn-lg">
                            <i class="fas fa-cart-shopping me-2"></i>Mon panier
                        </a>
                    {% endif %}
                </div>
            </div>
            <div class="col-lg-5">
                <div class="hero-books-grid">
                    {% for livre in livres|slice(0, 4) %}
                        <div class="hero-book-tile shadow-sm">
                            <img
                                src="{{ livre.imageUrl ? livre.imageUrl : asset('assets/img/book-placeholder.svg') }}"
                                alt="{{ livre.titre }}"
                                class="img-fluid rounded-3"
                                onerror="this.src='{{ asset('assets/img/book-placeholder.svg') }}'; this.onerror=null;"
                            >
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0"><i class="fas fa-book text-primary me-2"></i>Livres en vedette</h2>
                <a href="{{ path('livre_index') }}" class="btn btn-sm btn-outline-primary">Tout voir</a>
            </div>

            <div class="row g-4">
                {% for livre in livres %}
                    <div class="col-md-6">
                        <div class="card book-card h-100 border-0 shadow-sm">
                            <img
                                src="{{ livre.imageUrl ? livre.imageUrl : asset('assets/img/book-placeholder.svg') }}"
                                alt="{{ livre.titre }}"
                                class="book-card-cover"
                                onerror="this.src='{{ asset('assets/img/book-placeholder.svg') }}'; this.onerror=null;"
                            >
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                                    <h5 class="card-title mb-0">{{ livre.titre }}</h5>
                                    <span class="badge bg-primary">{{ livre.note }}/20</span>
                                </div>
                                <p class="text-muted small mb-2">
                                    {% for auteur in livre.auteurs %}
                                        {{ auteur }}{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </p>
                                <p class="card-text text-muted flex-grow-1">{{ livre.description|default('Résumé indisponible.')|slice(0, 140) }}{% if livre.description and livre.description|length > 140 %}...{% endif %}</p>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <div>
                                        <div class="fw-bold text-primary fs-5">{{ livre.price|number_format(2, ',', ' ') }} €</div>
                                        <small class="text-muted">{{ livre.stock }} en stock</small>
                                    </div>
                                    <a href="{{ path('livre_show', {'id': livre.id}) }}" class="btn btn-outline-primary">Voir</a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="alert alert-info">Aucun livre disponible pour le moment.</div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-feather-alt me-2"></i>Auteurs disponibles</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        {% for auteur in auteurs %}
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span>{{ auteur.nomPrenom }}</span>
                                <span class="badge bg-light text-primary">{{ auteur.nationalite }}</span>
                            </li>
                        {% else %}
                            <li class="list-group-item px-0 text-muted">Aucun auteur disponible.</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-tags me-2"></i>Catégories</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        {% for genre in genres %}
                            <span class="badge bg-light text-primary border">{{ genre.nom }}</span>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
