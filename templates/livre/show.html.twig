{% extends 'navbar.html.twig' %}

{% block title %}{{ livre.titre }}{% endblock %}

{% block body %}
<div class="container">
    <div class="mb-4">
        <a href="{{ path('livre_index') }}" class="btn btn-outline-secondary mb-3">
            <i class="fas fa-arrow-left me-2"></i>Retour à la liste
        </a>
    </div>

    <div class="card shadow-lg mb-4">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0"><i class="fas fa-book me-2"></i>{{ livre.titre }}</h2>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <th class="text-muted w-50"><i class="fas fa-barcode me-2"></i>ISBN</th>
                                <td><strong>{{ livre.isbn }}</strong></td>
                            </tr>
                            <tr>
                                <th class="text-muted"><i class="fas fa-file-alt me-2"></i>Nombre de pages</th>
                                <td><strong>{{ livre.nombrePages }} pages</strong></td>
                            </tr>
                            <tr>
                                <th class="text-muted"><i class="fas fa-calendar me-2"></i>Date de parution</th>
                                <td><strong>{{ livre.dateDeParution ? livre.dateDeParution|date('d/m/Y') : 'Non spécifiée' }}</strong></td>
                            </tr>
                            <tr>
                                <th class="text-muted"><i class="fas fa-star me-2"></i>Note</th>
                                <td>
                                    <span class="badge fs-6 
                                        {% if livre.note > 17 %}bg-success
                                        {% elseif livre.note > 14 %}bg-primary
                                        {% elseif livre.note >= 10 %}bg-warning
                                        {% else %}bg-danger
                                        {% endif %}">
                                        {{ livre.note }}/20
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <h5 class="text-muted mb-3"><i class="fas fa-feather-alt me-2"></i>Auteurs</h5>
                        <div>
                            {% for auteur in livre.auteurs %}
                                <span class="badge bg-secondary fs-6 me-2 mb-2 p-2">
                                    <i class="fas fa-user-edit me-1"></i>{{ auteur }}
                                </span>
                            {% endfor %}
                        </div>
                    </div>
                    <div>
                        <h5 class="text-muted mb-3"><i class="fas fa-tags me-2"></i>Genres</h5>
                        <div>
                            {% for genre in livre.genres %}
                                <span class="badge bg-info fs-6 me-2 mb-2 p-2">
                                    <i class="fas fa-tag me-1"></i>{{ genre }}
                                </span>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if is_granted('ROLE_ADMIN') %}
        <div class="d-flex gap-2 justify-content-center">
            <a href="{{ path('livre_edit', {'id': livre.id}) }}" class="btn btn-warning">
                <i class="fas fa-edit me-2"></i>Modifier
            </a>
            {{ include('livre/_delete_form.html.twig') }}
        </div>
    {% endif %}
</div>
{% endblock %}
