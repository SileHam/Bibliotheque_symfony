{% extends 'navbar.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}
<div class="container">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-1"><i class="fas fa-cart-shopping text-primary me-2"></i>Mon panier</h1>
            <p class="text-muted mb-0">{{ cart.totalQuantity }} article{{ cart.totalQuantity > 1 ? 's' : '' }}</p>
        </div>
        <a href="{{ path('livre_index') }}" class="btn btn-outline-primary">
            <i class="fas fa-book me-2"></i>Continuer les achats
        </a>
    </div>

    {% for message in app.flashes('Success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    {% for message in app.flashes('Warning') %}
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% if cart.items is empty %}
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fas fa-cart-shopping fa-3x text-primary mb-3"></i>
                <h2 class="h4">Votre panier est vide</h2>
                <p class="text-muted">Ajoutez quelques livres au panier pour commencer vos achats.</p>
                <a href="{{ path('livre_index') }}" class="btn btn-primary">
                    <i class="fas fa-book-open me-2"></i>Explorer le catalogue
                </a>
            </div>
        </div>
    {% else %}
        <div class="row g-4">
            <div class="col-lg-8">
                {% for item in cart.items %}
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body">
                            <div class="row g-3 align-items-center">
                                <div class="col-md-3">
                                    <img
                                        src="{{ item.livre.imageUrl ? item.livre.imageUrl : asset('assets/img/book-placeholder.svg') }}"
                                        alt="{{ item.livre.titre }}"
                                        class="cart-cover img-fluid rounded-3"
                                        onerror="this.src='{{ asset('assets/img/book-placeholder.svg') }}'; this.onerror=null;"
                                    >
                                </div>
                                <div class="col-md-5">
                                    <h2 class="h5 mb-1">{{ item.livre.titre }}</h2>
                                    <p class="text-muted small mb-2">
                                        {% for auteur in item.livre.auteurs %}
                                            {{ auteur }}{% if not loop.last %}, {% endif %}
                                        {% endfor %}
                                    </p>
                                    <div class="fw-semibold text-primary">{{ item.livre.price|number_format(2, ',', ' ') }} €</div>
                                </div>
                                <div class="col-md-4">
                                    <form method="post" action="{{ path('cart_update', {'id': item.id}) }}" class="d-flex align-items-center gap-2 mb-2">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cart_update_' ~ item.id) }}">
                                        <input type="number" name="quantity" value="{{ item.quantity }}" min="1" max="{{ item.livre.stock }}" class="form-control">
                                        <button type="submit" class="btn btn-outline-primary">
                                            <i class="fas fa-rotate"></i>
                                        </button>
                                    </form>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="small text-muted">Sous-total</span>
                                        <strong>{{ item.lineTotal|number_format(2, ',', ' ') }} €</strong>
                                    </div>
                                    <form method="post" action="{{ path('cart_remove', {'id': item.id}) }}" class="mt-2">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ item.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                            <i class="fas fa-trash me-2"></i>Retirer
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm cart-summary-card">
                    <div class="card-body">
                        <h2 class="h4 mb-4">Résumé</h2>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Articles</span>
                            <strong>{{ cart.totalQuantity }}</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span>Sous-total</span>
                            <strong>{{ cart.subtotal|number_format(2, ',', ' ') }} €</strong>
                        </div>
                        <button class="btn btn-primary w-100" disabled>
                            <i class="fas fa-credit-card me-2"></i>Paiement bientôt disponible
                        </button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
