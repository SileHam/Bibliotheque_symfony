{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'needs-validation'}}) }}
    <div class="row g-3">
        <div class="col-12">
            {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Roman, Science-Fiction, Biographie...'}}) }}
            {{ form_errors(form.nom) }}
        </div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-2"></i>{{ button_label|default('Ajouter') }}
        </button>
        <a href="{{ path('genre_index') }}" class="btn btn-secondary ms-2">
            <i class="fas fa-times me-2"></i>Annuler
        </a>
    </div>
{{ form_end(form) }}
