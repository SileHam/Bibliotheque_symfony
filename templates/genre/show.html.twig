{% extends 'navbar.html.twig' %}

{% block title %}{{ genre.nom }}{% endblock %}

{% block body %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="mb-4">
                <a href="{{ path('genre_index') }}" class="btn btn-outline-secondary mb-3">
                    <i class="fas fa-arrow-left me-2"></i>Retour à la liste
                </a>
            </div>

            <div class="card shadow-lg mb-4">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0"><i class="fas fa-tag me-2"></i>{{ genre.nom }}</h2>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <th class="text-muted w-50"><i class="fas fa-hashtag me-2"></i>ID</th>
                                <td><span class="badge bg-secondary">#{{ genre.id }}</span></td>
                            </tr>
                            <tr>
                                <th class="text-muted"><i class="fas fa-tag me-2"></i>Nom</th>
                                <td><strong>{{ genre.nom }}</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            {% if app.user and app.user.roles[0] == "ROLE_ADMIN" %}
                <div class="d-flex gap-2 justify-content-center">
                    <a href="{{ path('genre_edit', {'id': genre.id}) }}" class="btn btn-warning">
                        <i class="fas fa-edit me-2"></i>Modifier
                    </a>
                    {{ include('genre/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
