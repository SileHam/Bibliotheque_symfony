{% extends 'navbar.html.twig' %}

{% block title %}Nouvel Auteur{% endblock %}

{% block body %}
{% if app.user and app.user.roles[0] == "ROLE_ADMIN" %}
<div class="container">
    <div class="mb-4">
        <a href="{{ path('auteur_index') }}" class="btn btn-outline-secondary mb-3">
            <i class="fas fa-arrow-left me-2"></i>Retour à la liste
        </a>
    </div>

    <div class="card shadow-lg">
        <div class="card-header bg-success text-white">
            <h2 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Créer un nouvel auteur</h2>
        </div>
        <div class="card-body p-4">
            {{ include('auteur/_form.html.twig') }}
        </div>
    </div>
</div>
{% else %}
<div class="container">
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle me-2"></i>Vous n'avez pas les droits pour créer un auteur.
    </div>
</div>
{% endif %}
{% endblock %}
