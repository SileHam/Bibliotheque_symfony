{% extends 'navbar.html.twig' %}

{% block title %}Liste des Livres{% endblock %}

{% block body %}
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold"><i class="fas fa-book text-primary me-2"></i>Livres</h1>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('livre_new') }}" class="btn btn-success">
                <i class="fas fa-plus-circle me-2"></i>Ajouter un livre
            </a>
        {% endif %}
    </div>

    <!-- Flash Messages -->
    {% for message in app.flashes('Success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    {% for message in app.flashes('Warning') %}
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <!-- Search Form -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            {{ form_start(search, {'attr': {'class': 'row g-3'}}) }}
                <div class="col-md-8">
                    {{ form_row(search.titre, {'attr': {'class': 'form-control', 'placeholder': 'Rechercher un livre...'}}) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(search.Rechercher, {'attr': {'class': 'btn btn-primary w-100'}}) }}
                </div>
            {{ form_end(search) }}
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ISBN</th>
                            <th>Titre</th>
                            <th>Auteurs</th>
                            <th>Genres</th>
                            <th>Pages</th>
                            <th>Date de parution</th>
                            <th>Note</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for livre in livres %}
                            <tr>
                                <td><small class="text-muted">{{ livre.isbn }}</small></td>
                                <td>
                                    <strong>{{ livre.titre }}</strong>
                                </td>
                                <td>
                                    {% for auteur in livre.auteurs %}
                                        <span class="badge bg-secondary me-1">{{ auteur }}</span>
                                    {% endfor %}
                                </td>
                                <td>
                                    {% for genre in livre.genres %}
                                        <span class="badge bg-info me-1">{{ genre }}</span>
                                    {% endfor %}
                                </td>
                                <td><i class="fas fa-file-alt text-muted me-1"></i>{{ livre.nombrePages }}</td>
                                <td>
                                    <i class="fas fa-calendar text-muted me-1"></i>
                                    {{ livre.dateDeParution ? livre.dateDeParution|date('d/m/Y') : 'N/A' }}
                                </td>
                                <td>
                                    <span class="badge 
                                        {% if livre.note > 17 %}bg-success
                                        {% elseif livre.note > 14 %}bg-primary
                                        {% elseif livre.note >= 10 %}bg-warning
                                        {% else %}bg-danger
                                        {% endif %}">
                                        {{ livre.note }}/20
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a href="{{ path('livre_show', {'id': livre.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a href="{{ path('livre_edit', {'id': livre.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="fas fa-book-open fa-3x mb-3 d-block"></i>
                                    Aucun livre trouvé
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    {% if search.titre and totalLivres > 5 %}
        <nav aria-label="Pagination des livres" class="mt-4">
            <ul class="pagination justify-content-center">
                {% for i in 1..((totalLivres/5)|round(0,'ceil')) %}
                    <li class="page-item">
                        <a class="page-link" href="{{ path("livre_index", {page : i}) }}">{{ i }}</a>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    {% endif %}
</div>
{% endblock %}
