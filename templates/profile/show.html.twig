{% extends 'navbar.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="container">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-1"><i class="fas fa-user-circle text-primary me-2"></i>Mon profil</h1>
            <p class="text-muted mb-0">Consultez vos informations et votre historique d activite.</p>
        </div>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-primary mt-3 mt-lg-0">
                <i class="fas fa-gauge-high me-2"></i>Retour au dashboard
            </a>
        {% endif %}
    </div>

    {% for message in app.flashes('Success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white">
                    <h2 class="h5 mb-0"><i class="fas fa-id-card me-2"></i>Informations</h2>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Email</dt>
                        <dd class="col-sm-7">{{ app.user.email }}</dd>

                        <dt class="col-sm-5">Role principal</dt>
                        <dd class="col-sm-7">
                            {% if is_granted('ROLE_ADMIN') %}
                                <span class="badge bg-warning text-dark">Administrateur</span>
                            {% else %}
                                <span class="badge bg-secondary">Utilisateur</span>
                            {% endif %}
                        </dd>

                        <dt class="col-sm-5">Verification</dt>
                        <dd class="col-sm-7">
                            {% if app.user.isVerified %}
                                <span class="badge bg-success">Compte verifie</span>
                            {% else %}
                                <span class="badge bg-secondary">Non verifie</span>
                            {% endif %}
                        </dd>

                        <dt class="col-sm-5">Derniere connexion</dt>
                        <dd class="col-sm-7">
                            {% if lastLogin %}
                                {{ lastLogin.createdAt|date('d/m/Y H:i') }}
                            {% else %}
                                Jamais enregistree
                            {% endif %}
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h2 class="h5 mb-0"><i class="fas fa-user-pen me-2 text-primary"></i>Mettre a jour mon profil</h2>
                </div>
                <div class="card-body">
                    {{ form_start(profileForm) }}
                        <div class="mb-3">
                            {{ form_row(profileForm.email) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(profileForm.plainPassword) }}
                        </div>
                        <button class="btn btn-primary" type="submit">
                            <i class="fas fa-floppy-disk me-2"></i>Enregistrer
                        </button>
                    {{ form_end(profileForm) }}
                </div>
            </div>

            <div class="card shadow-sm border-0 mt-4">
                <div class="card-header bg-dark text-white">
                    <h2 class="h5 mb-0"><i class="fas fa-clock-rotate-left me-2"></i>Historique utilisateur</h2>
                </div>
                <div class="card-body">
                    {% if recentActivities is not empty %}
                        <div class="list-group list-group-flush">
                            {% for activity in recentActivities %}
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-start gap-3">
                                        <div>
                                            <div class="fw-semibold">{{ activity.description }}</div>
                                            <div class="text-muted small">{{ activity.action }}</div>
                                        </div>
                                        <span class="badge bg-light text-dark">{{ activity.createdAt|date('d/m/Y H:i') }}</span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info mb-0">Aucune action enregistree pour le moment.</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
