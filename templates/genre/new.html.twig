{% extends 'navbar.html.twig' %}

{% block title %}Nouveau Genre{% endblock %}

{% block body %}
{% if is_granted('ROLE_ADMIN') %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="mb-4">
                <a href="{{ path('genre_index') }}" class="btn btn-outline-secondary mb-3">
                    <i class="fas fa-arrow-left me-2"></i>Retour à la liste
                </a>
            </div>

            <div class="card shadow-lg">
                <div class="card-header bg-success text-white">
                    <h2 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Créer un nouveau genre</h2>
                </div>
                <div class="card-body p-4">
                    {{ include('genre/_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% else %}
<div class="container">
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle me-2"></i>Vous n'avez pas les droits pour créer un genre.
    </div>
</div>
{% endif %}
{% endblock %}
