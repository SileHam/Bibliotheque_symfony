{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'needs-validation'}}) }}
    <div class="row g-3">
        <div class="col-md-6">
            {{ form_label(form.isbn, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.isbn, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.isbn) }}
        </div>
        <div class="col-md-6">
            {{ form_label(form.titre, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.titre) }}
        </div>
        <div class="col-md-6">
            {{ form_label(form.nombre_pages, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.nombre_pages, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.nombre_pages) }}
        </div>
        <div class="col-md-6">
            {{ form_label(form.date_de_parution, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.date_de_parution, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.date_de_parution) }}
        </div>
        <div class="col-md-6">
            {{ form_label(form.note, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.note, {'attr': {'class': 'form-control', 'min': '0', 'max': '20'}}) }}
            {{ form_errors(form.note) }}
            <small class="form-text text-muted">Note sur 20</small>
        </div>
        <div class="col-12">
            {{ form_label(form.auteurs, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.auteurs, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.auteurs) }}
        </div>
        <div class="col-12">
            {{ form_label(form.genres, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.genres, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.genres) }}
        </div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-2"></i>{{ button_label|default('Enregistrer') }}
        </button>
        <a href="{{ path('livre_index') }}" class="btn btn-secondary ms-2">
            <i class="fas fa-times me-2"></i>Annuler
        </a>
    </div>
{{ form_end(form) }}
