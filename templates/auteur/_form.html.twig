{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'needs-validation'}}) }}
    <div class="row g-3">
        <div class="col-12">
            {{ form_label(form.nom_prenom, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.nom_prenom, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.nom_prenom) }}
        </div>
        <div class="col-md-6">
            {{ form_label(form.sexe, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.sexe, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.sexe) }}
        </div>
        <div class="col-md-6">
            {{ form_label(form.date_de_naissance, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.date_de_naissance, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.date_de_naissance) }}
        </div>
        <div class="col-12">
            {{ form_label(form.nationalite, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.nationalite, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.nationalite) }}
        </div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-2"></i>{{ button_label|default('Enregistrer') }}
        </button>
        <a href="{{ path('auteur_index') }}" class="btn btn-secondary ms-2">
            <i class="fas fa-times me-2"></i>Annuler
        </a>
    </div>
{{ form_end(form) }}
